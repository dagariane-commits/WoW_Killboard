[Unit]
Description=WoW Killboard — Frontline Combat & Marks of Spite Platform
After=network.target

[Service]
Type=simple
User=wowkillboard
Group=wowkillboard
WorkingDirectory=/opt/wowkillboard
Environment="PYTHONUNBUFFERED=1"
Environment="PORT=8080"
Environment="DB_PATH=/opt/wowkillboard/data/killboard.db"
Environment="ADMIN_SECRET_KEY=CHANGE_TO_SECURE_RANDOM_SECRET_KEY"
ExecStart=/opt/wowkillboard/venv/bin/python web/server.py
Restart=always
RestartSec=5s

# Security Sandbox
ProtectSystem=full
PrivateTmp=true
NoNewPrivileges=true

# Standard Logging to systemd journal
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
